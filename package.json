{
  "name": "chat-pedagogique-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "oxfmt",
    "preview": "vite preview",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "playwright test --ui",
    "test:e2e": "playwright test --reporter=line",
    "test:e2e:headed": "playwright test --headed --reporter=line",
    "audit": "lighthouse http://localhost:5173/chat-llm/ --output json --output html --output-path ./lighthouse-report --chrome-flags=\"--headless\" --only-categories=accessibility,best-practices,seo,performance",
    "audit:ci": "node scripts/lighthouse-ci.js",
    "pricing": "bun scripts/fetch-pricing.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.2",
    "localforage": "^1.10.0",
    "lucide-react": "^1.73.0",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "chrome-launcher": "^1.2.3",
    "jsdom": "^31.0.1",
    "lighthouse": "^13.6.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
