{
  "name": "chat-pedagogique-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "playwright test --ui",
    "test:e2e": "playwright test --reporter=line",
    "test:e2e:headed": "playwright test --headed --reporter=line",
    "audit": "lighthouse http://localhost:5173/chat-llm/ --output json --output html --output-path ./lighthouse-report --chrome-flags=\"--headless\" --only-categories=accessibility,best-practices,seo,performance",
    "audit:ci": "node scripts/lighthouse-ci.js",
    "pricing": "bun scripts/fetch-pricing.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.2",
    "localforage": "^1.10.0",
    "lucide-react": "^1.73.0",
    "mermaid": "^12.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.5"
  },
  "overrides": {
    "baseline-browser-mapping": "^2.11.37",
    "brace-expansion": "^5.0.13",
    "browserslist": "^4.29.5",
    "minimatch": "^11.0.8",
    "source-map-js": "^1.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "chrome-launcher": "^1.2.3",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "lighthouse": "^13.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
